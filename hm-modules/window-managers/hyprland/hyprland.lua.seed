-------------------------------
---- ENVIRONMENT VARIABLES ----
-------------------------------

hl.env("QT_QPA_PLATFORM", "wayland")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")
hl.env("QT_QPA_PLATFORMTHEME", "gtk3")
hl.env("QT_QPA_PLATFORMTHEME_QT6", "gtk3")
hl.env("MESA_GL_VERSION_OVERRIDE", "4.3")
hl.env("MESA_GLSL_VERSION_OVERRIDE", "430")

-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("systemctl --user start hyprpolkitagent")
    hl.exec_cmd("wvkbd-start")
    hl.exec_cmd('bash -c "wl-paste --watch cliphist store &"')
    hl.exec_cmd("hypr-start")
    hl.exec_cmd('tmux setenv -g HYPRLAND_INSTANCE_SIGNATURE "$HYPRLAND_INSTANCE_SIGNATURE"')
end)

-----------------------
---- LOOK AND FEEL ----
-----------------------

-- Rose Pine (main) palette
local rp = {
    base = "191724",
    muted = "6e6a86",
    text = "e0def4",
    gold = "f6c177",
    rose = "ebbcba",
    pine = "31748f",
    foam = "9ccfd8",
    iris = "c4a7e7",
}

hl.config({
    general = {
        gaps_in = 4,
        border_size = 3,
        col = {
            active_border = "rgb(" .. rp.gold .. ")",
            inactive_border = "rgb(" .. rp.muted .. ")",
        },
    },

    decoration = {
        rounding = 2,
        rounding_power = 5.0,

        shadow = {
            enabled = false,
            range = 30,
            render_power = 5,
            offset = { 0, 5 },
            color = "rgba(00000070)",
        },
    },

    group = {
        col = {
            border_active = "rgb(" .. rp.iris .. ")",
            border_inactive = "rgb(" .. rp.muted .. ")",
            border_locked_active = "rgb(" .. rp.foam .. ")",
        },
        groupbar = {
            col = {
                active = "rgb(" .. rp.iris .. ")",
                inactive = "rgb(" .. rp.muted .. ")",
                text_color = "rgb(" .. rp.text .. ")",
            },
        },
    },

    misc = {
        background_color = "rgb(" .. rp.base .. ")",
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        enable_swallow = true,
        swallow_regex = "kitty",
        key_press_enables_dpms = false,
        mouse_move_enables_dpms = true,
    },

    dwindle = {
        force_split = 2,
        preserve_split = true,
    },

    debug = {
        disable_logs = true,
    },
})

