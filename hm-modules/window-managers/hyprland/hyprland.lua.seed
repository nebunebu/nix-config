--------------------------------
---- WINDOWS AND WORKSPACES ----
--------------------------------

local function floatCentered(match, size)
    hl.window_rule({ match = match, float = true, center = true, size = size })
end

floatCentered({ title = ".*blob:https://canary.discord.com/.*" }, { "90%", "90%" })
floatCentered({ initial_class = "^(Discord)$", title = "(Save File)" }, { "90%", "90%" })
floatCentered({ title = ".*HyperTTS.*" }, { "90%", "90%" })
floatCentered({ title = ".*Browse.*" }, { "90%", "90%" })
floatCentered({ initial_class = "^(electron)$", initial_title = "^(Open Files)$" }, { "90%", "90%" })
floatCentered({ initial_class = "^(anki)$", initial_title = "^(Edit Current)$" }, { "90%", "90%" })
floatCentered({ initial_class = "^(anki)$", initial_title = "^(Add)$" }, { "90%", "90%" })
floatCentered({ initial_class = "^(anki)$", initial_title = "^(Anki)$" }, { "90%", "90%" })
floatCentered({ initial_class = "^(anki)$", initial_title = "^(Import File)$" }, { "90%", "90%" })
floatCentered({ initial_class = "^(anki)$", initial_title = "^(Add-ons)$" }, { "90%", "90%" })
floatCentered({ initial_class = "^(anki)$", initial_title = "^(Leech Toolkit.*)$" }, { "90%", "90%" })
floatCentered({ initial_class = "^(org.quickshell)$", initial_title = "^(Settings)$" }, { "90%", "90%" })

hl.window_rule({ match = { float = true }, border_color = "rgb(" .. rp.iris .. ")" })
hl.window_rule({ match = { fullscreen = true }, border_color = "rgb(" .. rp.pine .. ")" })
hl.window_rule({ match = { pin = true }, border_color = "rgb(" .. rp.rose .. ") rgb(" .. rp.rose .. ")" })

hl.window_rule({ match = { float = true }, center = true })
-- NOTE: legacy `max_size 70% 70%` was per-axis percentage; the new `max_size`
-- effect is documented as a literal-pixel vec2 (unlike size/move, which
-- support "N%"/expression strings). Left as percentages here since Hyprland's
-- vec2 parser has historically accepted "%" tokens on most size-like fields --
-- verify with `hyprctl reload` that floating windows actually get capped.
hl.window_rule({ match = { float = true }, max_size = { "70%", "70%" } })

hl.window_rule({
    match = { class = "^(firefox)$", initial_title = "^(Sign in - Google Accounts.*)$" },
    float = true,
    center = true,
    size = { "70%", "70%" },
})
hl.window_rule({
    match = { class = "^(firefox)$", initial_title = "^(Library)$" },
    float = true,
    center = true,
    size = { "90%", "70%" },
})
hl.window_rule({
    match = { class = "^(tridactyl)$" },
    float = true,
    center = true,
    size = { "38%", "87%" },
    move = { "60%", "5%" },
})

